{
  "name": "craftbook",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "local:start": "node scripts/local-stack.mjs start",
    "local:stop": "node scripts/local-stack.mjs stop",
    "db:migrate": "node scripts/local-stack.mjs migrate",
    "local:env": "tsx scripts/local-env.ts",
    "local:account": "tsx scripts/local-account.ts",
    "local:provision": "tsx scripts/account-ops.ts provision",
    "test:integration": "node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "ops:create": "tsx scripts/account-ops.ts create",
    "ops:provision": "tsx scripts/account-ops.ts provision",
    "ops:reset": "tsx scripts/account-ops.ts reset",
    "ops:deactivate": "tsx scripts/account-ops.ts deactivate",
    "ops:resume": "tsx scripts/account-ops.ts resume",
    "ops:status": "tsx scripts/account-ops.ts status",
    "local:storage": "tsx scripts/local-storage.ts",
    "files:cleanup": "node --conditions=react-server --import tsx scripts/files-cleanup.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tiptap/core": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.12.1",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "3.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "supabase": "3.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
