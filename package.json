{
  "name": "craftbook",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "local:start": "node scripts/local-stack.mjs start",
    "local:stop": "node scripts/local-stack.mjs stop",
    "db:migrate": "node scripts/local-stack.mjs migrate",
    "local:env": "tsx scripts/local-env.ts",
    "local:account": "tsx scripts/local-account.ts",
    "local:provision": "tsx scripts/account-ops.ts provision",
    "test:integration": "node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "ops:create": "tsx scripts/account-ops.ts create",
    "ops:provision": "tsx scripts/account-ops.ts provision",
    "ops:reset": "tsx scripts/account-ops.ts reset",
    "ops:deactivate": "tsx scripts/account-ops.ts deactivate",
    "ops:resume": "tsx scripts/account-ops.ts resume",
    "ops:status": "tsx scripts/account-ops.ts status",
    "local:storage": "tsx scripts/local-storage.ts",
    "files:cleanup": "node --conditions=react-server --import tsx scripts/files-cleanup.ts",
    "test:recovery": "node --conditions=react-server --import tsx --test tests/recovery/*.test.ts",
    "ops:backup": "tsx scripts/recovery-ops.ts backup",
    "ops:restore": "tsx scripts/recovery-ops.ts restore",
    "ops:backup:verify": "tsx scripts/recovery-ops.ts verify",
    "heroku-postbuild": "npm run build",
    "cloud:setup": "node --import tsx scripts/cloud/setup.ts",
    "cloud:inspect": "node --import tsx scripts/cloud/cli.ts",
    "cloud:migrate": "node --import tsx scripts/cloud/actions.ts migrate",
    "cloud:storage": "node --import tsx scripts/cloud/actions.ts storage",
    "cloud:runtime": "node --import tsx scripts/cloud/actions.ts runtime",
    "cloud:account:create": "node --import tsx scripts/account-ops.ts create --cloud",
    "cloud:account:provision": "node --import tsx scripts/account-ops.ts provision --cloud",
    "cloud:account:reset": "node --import tsx scripts/account-ops.ts reset --cloud",
    "cloud:account:deactivate": "node --import tsx scripts/account-ops.ts deactivate --cloud",
    "cloud:account:resume": "node --import tsx scripts/account-ops.ts resume --cloud",
    "cloud:account:status": "node --import tsx scripts/account-ops.ts status --cloud",
    "cloud:auth": "node --import tsx scripts/cloud/actions.ts auth",
    "cloud:heroku": "node --import tsx scripts/cloud/actions.ts heroku",
    "cloud:eco": "node --import tsx scripts/cloud/actions.ts eco",
    "cloud:advisors": "node --import tsx scripts/cloud/actions.ts advisors",
    "cloud:backup": "node --import tsx scripts/cloud/actions.ts backup",
    "test:cloud": "node --conditions=react-server --import tsx --test tests/cloud/*.test.ts",
    "cloud:cert": "node --import tsx scripts/cloud/cert.ts",
    "cloud:first-account": "node --import tsx scripts/cloud/first-account.ts",
    "cloud:deploy": "node --import tsx scripts/cloud/deploy.ts",
    "cloud:release": "node --import tsx scripts/cloud/release.ts",
    "test:cloud:recovery": "CRAFTBOOK_TEST_PG_NETWORK_DUMP=1 node --conditions=react-server --import tsx --test tests/recovery/restore.test.ts",
    "cloud:ssl": "node --import tsx scripts/cloud/actions.ts ssl",
    "cloud:smoke": "node --import tsx scripts/cloud/smoke.ts",
    "cloud:files:cleanup": "node --conditions=react-server --import tsx scripts/cloud/files-cleanup.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tiptap/core": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.12.1",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "3.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "supabase": "3.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
