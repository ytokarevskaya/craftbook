# Etapa 1 tyto hodnoty nečte. Lokální spuštění nevyžaduje žádné klíče.
# Budoucí kanonická URL aplikace.
APP_URL=
# Budoucí Supabase URL a veřejný publishable klíč.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Privilegovaný klíč: pouze server / lokální ops, nikdy NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
# Runtime DB přístup: nevlastnická role bez BYPASSRLS.
DATABASE_URL=
# Oddělené migrační oprávnění; nepatří do běžného webového runtime.
MIGRATION_DATABASE_URL=
