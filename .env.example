# Web runtime: .env.local (ignorovaný soubor). Vygeneruje npm run local:env.
# Přesná veřejná origin URL pro kontrolu mutací; lokálně používejte jednotně localhost.
APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Pouze role craftbook_runtime, nikdy postgres/service role. Max. 5 pg spojení.
# Lokálně přímé spojení na loopback:54322; cloudový pooler se nyní nepoužívá.
DATABASE_URL=

# Oddělené lokální nástroje: .env.ops.local, NIKOLI webový runtime.
# Všechny nástroje odmítnou vzdálené Auth/DB URL. Žádné NEXT_PUBLIC tajemství.
MIGRATION_DATABASE_URL=
SUPABASE_SECRET_KEY=

# Etapa 3: ops:create/provision/reset/deactivate/resume/status používají stejné
# oddělené lokální přístupy. Žádná SMTP ani další webová tajemství nejsou potřeba.
# Hesla účtů patří pouze do skrytého interaktivního vstupu, nikdy do env souboru.

# Etapa 4: pouze serverový adaptér soukromého Storage, nikdy NEXT_PUBLIC.
# Lokálně doplní npm run local:storage; nepoužívá se k Auth administraci ve webu.
STORAGE_SECRET_KEY=
# Volitelné limity (bajty); lze snižovat do stanovených pevných maxim.
FILE_IMAGE_BYTES=5242880
FILE_DOCUMENT_BYTES=10485760
NOTE_CONTENT_BYTES=262144
# Podepsané odkazy používá server interně; prohlížeči doručuje private,no-store.
FILE_DOWNLOAD_TTL=60
# Nejméně 24 h, nikdy méně než platnost upload tokenu plus rezerva.
FILE_GRACE_HOURS=24

# Etapa 10: cloud používá samostatnou .env.ops.cloud.local dle
# config/cloud-ops.env.example. Nepřepisujte lokální soubory cloudem.
# Heroku runtime navíc potřebuje veřejnou PEM CA pro ověřování DB TLS:
DATABASE_CA_CERT=
