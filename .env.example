# Web runtime: .env.local (ignorovaný soubor). Vygeneruje npm run local:env.
# Přesná veřejná origin URL pro kontrolu mutací; lokálně používejte jednotně localhost.
APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Pouze role craftbook_runtime, nikdy postgres/service role. Max. 5 pg spojení.
# Lokálně přímé spojení na loopback:54322; cloudový pooler se nyní nepoužívá.
DATABASE_URL=

# Oddělené lokální nástroje: .env.ops.local, NIKOLI webový runtime.
# Všechny nástroje odmítnou vzdálené Auth/DB URL. Žádné NEXT_PUBLIC tajemství.
MIGRATION_DATABASE_URL=
SUPABASE_SECRET_KEY=
