# Pouze samostatné cloudové ops. Žádné automatické načítání .env.local.
SUPABASE_PROJECT_REF=vayxezlkyognarkqebbg
NEXT_PUBLIC_SUPABASE_URL=https://vayxezlkyognarkqebbg.supabase.co
APP_URL=https://craftbook-app-cab5aab2013a.herokuapp.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Osobní Management API token: ověření vlastnictví a nastavení Auth/Data API.
SUPABASE_ACCESS_TOKEN=
# Jen postgres tohoto projektu přes session pooler, URL-encoded heslo.
MIGRATION_DATABASE_URL=
# Samostatné heslo role vznikne při bootstrapu; není to heslo postgres.
DATABASE_URL=
# Volitelná PEM důvěryhodná CA z Dashboard → Database → SSL; zachovat nové řádky pomocí uvozovek.
DATABASE_CA_CERT=
# Přesné identifikátory z Heroku Settings, ne odhad z domény.
HEROKU_APP_NAME=
HEROKU_APP_ID=
# Account API token z Heroku; pouze lokální ops, nikdy Heroku web Config Vars.
HEROKU_API_KEY=

# První e-mail vyplňte jen v ignorované kopii, nikdy zde osobní údaje.
FIRST_ACCOUNT_EMAIL=
